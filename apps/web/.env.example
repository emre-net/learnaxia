# ─────────────────────────────────────────────────────────────────
# Learnaxia Web — Environment Variables Template
# Bu dosyayı kopyalayıp .env olarak kaydedin ve değerleri doldurun.
# .env asla git'e push edilmemeli!
# ─────────────────────────────────────────────────────────────────

# --- DATABASE ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB"

# --- NEXTAUTH ---
# Üretmek için: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="https://yourdomain.com"

# --- GOOGLE OAUTH ---
# https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- ADMIN ---
ADMIN_EMAIL=""
# Admin şifresi artık DB'de bcrypt hashli tutulmalı

# --- AI ---
GROQ_API_KEY=""

# --- EMAIL (Resend) ---
# https://resend.com
RESEND_API_KEY=""

# --- MOBILE JWT ---
# Üretmek için: openssl rand -base64 32
MOBILE_JWT_SECRET=""
MOBILE_REFRESH_TOKEN_PEPPER=""

# --- CRON ---
# Üretmek için: openssl rand -hex 32
CRON_SECRET=""

# --- STRIPE (Ödeme sistemi — opsiyonel) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- ADMİN (Public — client-side admin panel erişimi için) ---
# ADMIN_EMAIL ile aynı değeri girin
NEXT_PUBLIC_ADMIN_EMAIL=""

# --- SYNC SECRET (sync-visibility admin endpoint'i için) ---
# Üretmek için: openssl rand -hex 32
SYNC_SECRET=""
